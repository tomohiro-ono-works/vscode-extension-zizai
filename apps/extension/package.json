{
  "name": "zizai-notebook-input",
  "displayName": "ZizAI Notebook Input (Preview)",
  "description": "Notebook inline choice experiment. No Python execution or program generation.",
  "version": "0.0.2",
  "publisher": "zizai-lab",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomohiro-ono-works/vscode-extension-zizai.git"
  },
  "files": [
    "extension.cjs",
    "selection.cjs",
    "definitions.cjs",
    "definitions.yaml",
    "README.md",
    "node_modules/yaml/package.json",
    "node_modules/yaml/LICENSE",
    "node_modules/yaml/dist/**/*.js"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "main": "./extension.cjs",
  "scripts": {
    "test": "node --test ../../tests/unit/extension/*.test.cjs",
    "package:vsix": "vsce package --pre-release --skip-license --githubBranch codex/task-009-notebook-input"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
